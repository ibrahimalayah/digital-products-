# Copy to .env.local for local development. Never commit real values.

# --- Required in production ---
# Postgres connection string. Provision with: vercel integration add neon
DATABASE_URL=
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the deployment, e.g. https://your-domain.com
NEXT_PUBLIC_APP_URL=

# --- Payments (vercel integration add stripe) ---
STRIPE_SECRET_KEY=
# From the webhook endpoint you create for <app-url>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Security ---
# Protects /api/cron/daily. Vercel Cron sends it automatically once set.
CRON_SECRET=
# Encrypts creators' Postiz API keys at rest. openssl rand -base64 32
ENCRYPTION_KEY=
# One-time owner bootstrap: sign up, then open /claim and paste this value.
ADMIN_BOOTSTRAP_TOKEN=

# --- Email (password reset links) ---
# One of these; both have a free plan. Resend: https://resend.com/api-keys  Brevo: https://app.brevo.com/settings/keys/api
RESEND_API_KEY=
BREVO_API_KEY=
# The sender, e.g. Kitforge <hello@your-domain.com>. Brevo: an address you verified there.
# Resend without your own domain can only deliver to your own Resend account address.
EMAIL_FROM=

# --- AI ---
# Free-tier chain, tried in this order with automatic failover. Set one or more.
# (Same variable names as the Rekrutify project.)
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
# Local only: a FreeLLMAPI router, tried first when both are set.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
# Paid fallbacks after the chain:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Vercel AI Gateway: automatic on Vercel, but needs a card on the account.
#    Locally run `vercel env pull` or set:
AI_GATEWAY_API_KEY=
# Optional model override for the active provider.
AI_MODEL=

# --- Optional ---
# Publishing keys are entered per user in Settings, not here.
# Self-hosted Postiz API base. Default: https://api.postiz.com
POSTIZ_API_URL=
